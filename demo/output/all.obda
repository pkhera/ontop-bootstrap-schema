[PrefixDeclaration]
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
owl:		http://www.w3.org/2002/07/owl#
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#

[MappingDeclaration] @collection [[
mappingId	MAPPING-ID1
target		<http://example.org/ACCOUNT_MANAGER/EMPLOYEE_ID={EMPLOYEE_ID};CUSTOMER_ID={CUSTOMER_ID}> a <http://example.org/ACCOUNT_MANAGER> ; <http://example.org/ACCOUNT_MANAGER#EMPLOYEE_ID> {EMPLOYEE_ID}^^xsd:integer ; <http://example.org/ACCOUNT_MANAGER#CUSTOMER_ID> {CUSTOMER_ID}^^xsd:integer . 
source		SELECT * FROM "HR"."ACCOUNT_MANAGER"

mappingId	MAPPING-ID2
target		<http://example.org/ACCOUNT_MANAGER/EMPLOYEE_ID={ACCOUNT_MANAGER_EMPLOYEE_ID};CUSTOMER_ID={ACCOUNT_MANAGER_CUSTOMER_ID}> <http://example.org/ACCOUNT_MANAGER#ref-EMPLOYEE_ID> <http://example.org/EMPLOYEE/EMPLOYEE_ID={EMPLOYEE_EMPLOYEE_ID}> . 
source		SELECT "HR"."ACCOUNT_MANAGER"."EMPLOYEE_ID" AS "ACCOUNT_MANAGER_EMPLOYEE_ID", "HR"."ACCOUNT_MANAGER"."CUSTOMER_ID" AS "ACCOUNT_MANAGER_CUSTOMER_ID", "HR"."EMPLOYEE"."EMPLOYEE_ID" AS "EMPLOYEE_EMPLOYEE_ID" FROM "HR"."ACCOUNT_MANAGER", "HR"."EMPLOYEE" WHERE "HR"."ACCOUNT_MANAGER"."EMPLOYEE_ID" = "HR"."EMPLOYEE"."EMPLOYEE_ID"

mappingId	MAPPING-ID3
target		<http://example.org/ACCOUNT_MANAGER/EMPLOYEE_ID={ACCOUNT_MANAGER_EMPLOYEE_ID};CUSTOMER_ID={ACCOUNT_MANAGER_CUSTOMER_ID}> <http://example.org/ACCOUNT_MANAGER#ref-CUSTOMER_ID> <http://example.org/CUSTOMER/CUSTOMER_ID={CUSTOMER_CUSTOMER_ID}> . 
source		SELECT "HR"."ACCOUNT_MANAGER"."EMPLOYEE_ID" AS "ACCOUNT_MANAGER_EMPLOYEE_ID", "HR"."ACCOUNT_MANAGER"."CUSTOMER_ID" AS "ACCOUNT_MANAGER_CUSTOMER_ID", "SALES"."CUSTOMER"."CUSTOMER_ID" AS "CUSTOMER_CUSTOMER_ID" FROM "HR"."ACCOUNT_MANAGER", "SALES"."CUSTOMER" WHERE "HR"."ACCOUNT_MANAGER"."CUSTOMER_ID" = "SALES"."CUSTOMER"."CUSTOMER_ID"

mappingId	MAPPING-ID4
target		<http://example.org/INVOICE/INVOICE_ID={INVOICE_ID}> a <http://example.org/INVOICE> ; <http://example.org/INVOICE#INVOICE_ID> {INVOICE_ID}^^xsd:integer ; <http://example.org/INVOICE#CUSTOMER_ID> {CUSTOMER_ID}^^xsd:integer ; <http://example.org/INVOICE#ISSUED_ON> {ISSUED_ON}^^xsd:date ; <http://example.org/INVOICE#TOTAL_EUR> {TOTAL_EUR}^^xsd:decimal . 
source		SELECT * FROM "SALES"."INVOICE"

mappingId	MAPPING-ID5
target		<http://example.org/INVOICE/INVOICE_ID={INVOICE_INVOICE_ID}> <http://example.org/INVOICE#ref-CUSTOMER_ID> <http://example.org/CUSTOMER/CUSTOMER_ID={CUSTOMER_CUSTOMER_ID}> . 
source		SELECT "SALES"."INVOICE"."INVOICE_ID" AS "INVOICE_INVOICE_ID", "SALES"."CUSTOMER"."CUSTOMER_ID" AS "CUSTOMER_CUSTOMER_ID" FROM "SALES"."INVOICE", "SALES"."CUSTOMER" WHERE "SALES"."INVOICE"."CUSTOMER_ID" = "SALES"."CUSTOMER"."CUSTOMER_ID"

mappingId	MAPPING-ID6
target		<http://example.org/DEPARTMENT/DEPARTMENT_ID={DEPARTMENT_ID}> a <http://example.org/DEPARTMENT> ; <http://example.org/DEPARTMENT#DEPARTMENT_ID> {DEPARTMENT_ID}^^xsd:integer ; <http://example.org/DEPARTMENT#DEPARTMENT_NAME> {DEPARTMENT_NAME}^^xsd:string . 
source		SELECT * FROM "HR"."DEPARTMENT"

mappingId	MAPPING-ID7
target		<http://example.org/EMPLOYEE/EMPLOYEE_ID={EMPLOYEE_ID}> a <http://example.org/EMPLOYEE> ; <http://example.org/EMPLOYEE#EMPLOYEE_ID> {EMPLOYEE_ID}^^xsd:integer ; <http://example.org/EMPLOYEE#DEPARTMENT_ID> {DEPARTMENT_ID}^^xsd:integer ; <http://example.org/EMPLOYEE#LAST_NAME> {LAST_NAME}^^xsd:string ; <http://example.org/EMPLOYEE#HIRED_ON> {HIRED_ON}^^xsd:date ; <http://example.org/EMPLOYEE#MONTHLY_WAGE> {MONTHLY_WAGE}^^xsd:decimal . 
source		SELECT * FROM "HR"."EMPLOYEE"

mappingId	MAPPING-ID8
target		<http://example.org/EMPLOYEE/EMPLOYEE_ID={EMPLOYEE_EMPLOYEE_ID}> <http://example.org/EMPLOYEE#ref-DEPARTMENT_ID> <http://example.org/DEPARTMENT/DEPARTMENT_ID={DEPARTMENT_DEPARTMENT_ID}> . 
source		SELECT "HR"."EMPLOYEE"."EMPLOYEE_ID" AS "EMPLOYEE_EMPLOYEE_ID", "HR"."DEPARTMENT"."DEPARTMENT_ID" AS "DEPARTMENT_DEPARTMENT_ID" FROM "HR"."EMPLOYEE", "HR"."DEPARTMENT" WHERE "HR"."EMPLOYEE"."DEPARTMENT_ID" = "HR"."DEPARTMENT"."DEPARTMENT_ID"

mappingId	MAPPING-ID9
target		<http://example.org/EMPLOYEE_SKILL/EMPLOYEE_ID={EMPLOYEE_ID};SKILL_CODE={SKILL_CODE}> a <http://example.org/EMPLOYEE_SKILL> ; <http://example.org/EMPLOYEE_SKILL#EMPLOYEE_ID> {EMPLOYEE_ID}^^xsd:integer ; <http://example.org/EMPLOYEE_SKILL#SKILL_CODE> {SKILL_CODE}^^xsd:string ; <http://example.org/EMPLOYEE_SKILL#LEVEL> {LEVEL}^^xsd:integer . 
source		SELECT * FROM "HR"."EMPLOYEE_SKILL"

mappingId	MAPPING-ID10
target		<http://example.org/EMPLOYEE_SKILL/EMPLOYEE_ID={EMPLOYEE_SKILL_EMPLOYEE_ID};SKILL_CODE={EMPLOYEE_SKILL_SKILL_CODE}> <http://example.org/EMPLOYEE_SKILL#ref-EMPLOYEE_ID> <http://example.org/EMPLOYEE/EMPLOYEE_ID={EMPLOYEE_EMPLOYEE_ID}> . 
source		SELECT "HR"."EMPLOYEE_SKILL"."EMPLOYEE_ID" AS "EMPLOYEE_SKILL_EMPLOYEE_ID", "HR"."EMPLOYEE_SKILL"."SKILL_CODE" AS "EMPLOYEE_SKILL_SKILL_CODE", "HR"."EMPLOYEE"."EMPLOYEE_ID" AS "EMPLOYEE_EMPLOYEE_ID" FROM "HR"."EMPLOYEE_SKILL", "HR"."EMPLOYEE" WHERE "HR"."EMPLOYEE_SKILL"."EMPLOYEE_ID" = "HR"."EMPLOYEE"."EMPLOYEE_ID"

mappingId	MAPPING-ID11
target		<http://example.org/CUSTOMER/CUSTOMER_ID={CUSTOMER_ID}> a <http://example.org/CUSTOMER> ; <http://example.org/CUSTOMER#CUSTOMER_ID> {CUSTOMER_ID}^^xsd:integer ; <http://example.org/CUSTOMER#COMPANY_NAME> {COMPANY_NAME}^^xsd:string ; <http://example.org/CUSTOMER#CONTACT_EMAIL> {CONTACT_EMAIL}^^xsd:string ; <http://example.org/CUSTOMER#VAT_NUMBER> {VAT_NUMBER}^^xsd:string . 
source		SELECT * FROM "SALES"."CUSTOMER"
]]

